{
  "name": "mirar-ng",
  "version": "1.9.2",
  "scripts": {
    "ng": "ng",
    "envs": "node ./scripts/set-envs.js",
    "deleteFolder": "find /var/www/mirar/* -maxdepth 0 ! -name '.*' -exec rm -rf {} +",
    "start:dev": "npm run envs && npx ng serve --hmr --c=development",
    "start:prod": "npm run envs && ng serve --c=production",
    "build:dev": "npm run envs && npx ng build --c=development",
    "build:prod": "npm run envs && ng build --c=production",
    "build": "npm run envs && ng build --c=production",
    "build:deploy": "ng build && cp -r ./dist/mirar-ng/browser/* /var/www/mirar/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,js,json}\"",
    "format:lint": "npm run format && npm run lint:fix",
    "fix:line-endings": "prettier --write --end-of-line lf \"**/*.{ts,html,scss,css,js,json,md}\" \"!node_modules/**\" \"!dist/**\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.4",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@teritorio/maplibre-gl-teritorio-cluster": "^0.1.4",
    "@types/pdfmake": "^0.2.12",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "echarts-gl": "^2.0.9",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "^5.10.0",
    "ngx-echarts": "^21.0.0",
    "pdfmake": "^0.2.20",
    "primeclt": "^0.1.5",
    "primeicons": "^7.0.0",
    "primeng": "^20.2.0",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.6.0",
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.37.0",
    "@types/geojson": "^7946.0.16",
    "@types/jasmine": "~5.1.0",
    "@types/maplibre-gl": "^1.14.0",
    "angular-eslint": "20.6.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.10",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "~5.12.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
